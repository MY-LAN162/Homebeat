rules_version = '2';

// Luật bảo mật cho An Tâm (chạy được trên Firebase gói miễn phí Spark, không cần Cloud Functions).
// Chỉ người trong gia đình (uid có trong families/{id}.uids) mới đọc / ghi được dữ liệu gia đình đó.
// Vào gia đình: máy mới nhập mã 6 số → gửi yêu cầu (joinRequests/{uid}) → người trong gia đình bấm
// "Đồng ý" thì mới được thêm uid. Đoán trúng mã cũng không tự vào được.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.uids;
    }

    function addsOneRequester(familyId) {
      let added = request.resource.data.uids.removeAll(resource.data.uids);
      return request.resource.data.uids.hasAll(resource.data.uids)
        && added.size() == 1
        && exists(/databases/$(database)/documents/families/$(familyId)/joinRequests/$(added[0]));
    }
    // Mã kết nối có 2 loại: role 'parent' (máy của bố/mẹ, kèm memberId) và 'child' (máy mới của con, memberId rỗng).
    // ---- Kiểm tra dữ liệu ----
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || str(d[k], max); }
    function num(v, lo, hi) { return (v is int || v is float) && v >= lo && v <= hi; }
    function optNum(d, k, lo, hi) { return !(k in d) || num(d[k], lo, hi); }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function hhmm(v) { return v is string && v.matches('^[0-2][0-9]:[0-5][0-9]$'); }
    function day(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function list(v, max) { return v is list && v.size() <= max; }
    function optList(d, k, max) { return !(k in d) || list(d[k], max); }
    function validDoc(coll, id, d) {
      return (coll == 'members'
          && d.keys().hasOnly(['id', 'name', 'call', 'self', 'phone', 'note', 'textScale',
                               'birthYear', 'conditions', 'allergies', 'bloodType', 'insurance', 'hospital', 'address'])
          && d.id == id && str(d.name, 60) && d.call in ['Bố', 'Mẹ', 'Ông', 'Bà'] && d.self in ['Con', 'Cháu']
          && optStr(d, 'phone', 20) && optStr(d, 'note', 300) && optNum(d, 'textScale', 0.8, 2)
          && optNum(d, 'birthYear', 1900, 2025) && optList(d, 'conditions', 20) && optStr(d, 'allergies', 300)
          && optStr(d, 'bloodType', 4) && optStr(d, 'insurance', 20) && optStr(d, 'hospital', 120) && optStr(d, 'address', 200))
        || (coll == 'caregivers'
          && d.keys().hasOnly(['id', 'name', 'phone', 'order', 'sosOnly'])
          && d.id == id && str(d.name, 60) && str(d.phone, 20) && num(d.order, 0, 100) && optBool(d, 'sosOnly'))
        || (coll == 'medications'
          && d.keys().hasOnly(['id', 'memberId', 'name', 'purpose', 'pillsPerDose', 'times', 'afterMeal', 'stockPills', 'note', 'photoUri', 'createdAt', 'start', 'until', 'every', 'weekdays'])
          && (!('start' in d) || day(d.start)) && (!('until' in d) || day(d.until))
          && optNum(d, 'every', 1, 30) && optList(d, 'weekdays', 7)
          && d.id == id && str(d.memberId, 80) && str(d.name, 100) && d.name.size() > 0
          && num(d.pillsPerDose, 0, 20) && list(d.times, 12) && optBool(d, 'afterMeal')
          && optNum(d, 'stockPills', 0, 100000) && optStr(d, 'purpose', 100) && optStr(d, 'note', 300)
          && optStr(d, 'photoUri', 60000) && optStr(d, 'createdAt', 40))
        || (coll == 'appointments'
          && d.keys().hasOnly(['id', 'memberId', 'title', 'at', 'place', 'companion', 'questions', 'asked', 'bring', 'transcript', 'shareTranscript'])
          && d.id == id && str(d.memberId, 80) && str(d.title, 120) && str(d.at, 40)
          && optStr(d, 'place', 120) && optStr(d, 'companion', 60) && list(d.questions, 30)
          && optList(d, 'asked', 30) && optList(d, 'bring', 20) && optStr(d, 'transcript', 20000) && optBool(d, 'shareTranscript'))
        || (coll == 'doseLogs'
          && d.keys().hasOnly(['memberId', 'medId', 'date', 'time', 'status', 'at', 'reason'])
          && str(d.memberId, 80) && str(d.medId, 80) && day(d.date) && hhmm(d.time)
          && d.status in ['taken', 'skipped'] && str(d.at, 40)
          && (!('reason' in d) || d.reason in ['out', 'unable']))
        || (coll == 'checkins'
          && d.keys().hasOnly(['memberId', 'at', 'mood', 'symptoms'])
          && str(d.memberId, 80) && str(d.at, 40) && d.mood in ['good', 'tired', 'unwell'] && list(d.symptoms, 12))
        || (coll == 'bpReadings'
          && d.keys().hasOnly(['memberId', 'at', 'sys', 'dia', 'pulse'])
          && str(d.memberId, 80) && str(d.at, 40)
          && num(d.sys, 40, 300) && num(d.dia, 20, 200) && num(d.pulse, 20, 250))
        || (coll == 'sosEvents'
          && d.keys().hasOnly(['id', 'memberId', 'at', 'cancelled', 'lat', 'lng', 'ackBy', 'ackAt'])
          && d.id == id && str(d.memberId, 80) && str(d.at, 40) && d.cancelled is bool
          && optNum(d, 'lat', -90, 90) && optNum(d, 'lng', -180, 180)
          && optStr(d, 'ackBy', 60) && optStr(d, 'ackAt', 40))
        || (coll == 'messages'
          && d.keys().hasOnly(['id', 'memberId', 'from', 'text', 'at', 'seenAt'])
          && d.id == id && str(d.memberId, 80) && str(d.from, 60) && str(d.text, 200) && d.text.size() > 0
          && str(d.at, 40) && optStr(d, 'seenAt', 40));
    }
    function validBilling(b) {
      return b.keys().hasOnly(['trialStart', 'refCode', 'referredBy', 'plan', 'period', 'paidUntil', 'firstPaidAt'])
        && str(b.trialStart, 40) && b.refCode is string && b.refCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && (!('referredBy' in b) || (b.referredBy is string && b.referredBy.matches('^[A-HJ-NP-Z2-9]{6}$') && b.referredBy != b.refCode))
        && (!('plan' in b) || b.plan in ['small', 'medium', 'large'])
        && (!('period' in b) || b.period in ['m', 'y'])
        && optStr(b, 'paidUntil', 40) && optStr(b, 'firstPaidAt', 40);
    }
    function validSettings(s) {
      return s is map
        && s.keys().hasOnly(['lateMinutes', 'stillHours', 'checkinBy', 'bpSys', 'bpDia', 'excludeSleep', 'sleepStart', 'sleepEnd', 'timeZone', 'autoSpeak', 'bpRemind'])
        && optNum(s, 'lateMinutes', 5, 240) && optNum(s, 'stillHours', 1, 48)
        && (!('checkinBy' in s) || hhmm(s.checkinBy)) && optNum(s, 'bpSys', 80, 250) && optNum(s, 'bpDia', 40, 150)
        && optBool(s, 'excludeSleep') && (!('sleepStart' in s) || hhmm(s.sleepStart)) && (!('sleepEnd' in s) || hhmm(s.sleepEnd))
        && optStr(s, 'timeZone', 60) && optBool(s, 'autoSpeak') && (!('bpRemind' in s) || hhmm(s.bpRemind));
    }

    function removesAllowed() {
      let removed = resource.data.uids.removeAll(request.resource.data.uids);
      return resource.data.uids.hasAll(request.resource.data.uids)
        && removed.size() >= 1
        && !(resource.data.ownerUid in removed)
        && (request.auth.uid == resource.data.ownerUid || removed == [request.auth.uid]);
    }
    // Vai trò của máy đang gọi, theo yêu cầu vào gia đình đã được Đồng ý (máy không tự đổi được).
    // Máy tạo gia đình (không có yêu cầu vào) là máy của con.
    function approvedRole(familyId) {
      let jr = /databases/$(database)/documents/families/$(familyId)/joinRequests/$(request.auth.uid);
      return exists(jr) ? get(jr).data.role : 'child';
    }
    // Xóa dữ liệu gia đình (thuốc, lịch khám, người, nhật ký): chỉ máy của con hoặc máy quản lý.
    // Máy của bố mẹ không cần xóa gì; nếu máy đó nhiễm mã độc cũng không xóa được dữ liệu cả nhà.
    function canDeleteData(familyId) {
      return isOwner(familyId) || approvedRole(familyId) == 'child';
    }
    function isOwner(familyId) {
      return signedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
    }
    function validCode(code, familyId, memberId, role) {
      let path = /databases/$(database)/documents/pairingCodes/$(code);
      let c = get(path).data;
      return exists(path)
        && c.familyId == familyId
        && c.memberId == memberId
        && c.get('role', 'parent') == role
        && c.expiresAtMs > request.time.toMillis();
    }

    match /families/{familyId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      // Tạo gia đình mới: chỉ có chính mình trong danh sách.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.uids == [request.auth.uid];
      // Người trong gia đình được: sửa cài đặt; thêm ĐÚNG MỘT máy đã gửi yêu cầu vào gia đình.
      // Gỡ máy: chỉ người tạo gia đình (chủ) gỡ được máy khác; máy khác chỉ tự rời được; chủ không tự gỡ mình.
      // Chuyển quyền chủ: chỉ chủ, cho một máy đang trong gia đình.
      allow update: if isMember(familyId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings']) && validSettings(request.resource.data.settings))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids']) && (
          addsOneRequester(familyId) || removesAllowed()
        ))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
          && request.auth.uid == resource.data.ownerUid
          && request.resource.data.ownerUid in resource.data.uids)
      );
      // Xóa cả gia đình: chỉ máy quản lý (dùng cho nút "Xóa toàn bộ dữ liệu gia đình").
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Dữ liệu gia đình: người, người nhận cảnh báo, thuốc, lịch khám, sự kiện.
      // Đọc / xóa: người trong gia đình. Ghi: người trong gia đình, VÀ dữ liệu phải đúng dạng
      // (đúng trường, đúng kiểu, độ dài giới hạn, số trong khoảng hợp lý) để máy lỗi hay mã độc không ghi được rác.
      match /{coll}/{docId} {
        allow read: if isMember(familyId)
          && coll in ['members', 'caregivers', 'medications', 'appointments',
                      'doseLogs', 'checkins', 'bpReadings', 'sosEvents', 'messages'];
        allow delete: if isMember(familyId) && canDeleteData(familyId)
          && coll in ['members', 'caregivers', 'medications', 'appointments',
                      'doseLogs', 'checkins', 'bpReadings', 'sosEvents', 'messages'];
        allow create, update: if isMember(familyId) && validDoc(coll, docId, request.resource.data);
      }
      // Nhịp "còn sống" của máy bố mẹ.
      match /heartbeats/{memberId} {
        allow read: if isMember(familyId);
        allow delete: if isOwner(familyId);
        allow write: if isMember(familyId) && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['at', 'battery', 'uid', 'notifOff'])
          && (!('notifOff' in request.resource.data) || request.resource.data.notifOff is bool)
          && str(request.resource.data.at, 40) && optNum(request.resource.data, 'battery', 0, 100);
      }
      // Thông tin từng máy (vai trò, mã nhận thông báo): mỗi máy chỉ sửa của chính mình.
      match /devices/{uid} {
        allow read: if isMember(familyId);
        allow delete: if isMember(familyId) && (uid == request.auth.uid || isOwner(familyId));
        allow create, update: if isMember(familyId) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['role', 'memberId', 'pushToken', 'platform', 'updatedAt', 'joinedAt'])
          && optStr(request.resource.data, 'pushToken', 300) && optStr(request.resource.data, 'memberId', 80)
          && optStr(request.resource.data, 'platform', 20)
          && (!('role' in request.resource.data) || (request.resource.data.role in ['child', 'parent']
              && (isOwner(familyId) || request.resource.data.role == approvedRole(familyId))));
      }
      // Yêu cầu vào gia đình: máy mới tự tạo (phải có mã đúng, còn hạn); người trong gia đình
      // đồng ý / từ chối. Máy mới đọc được yêu cầu của chính mình để biết kết quả.
      match /joinRequests/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'code', 'memberId', 'role', 'status', 'device', 'at'])
          && optStr(request.resource.data, 'device', 40) && optStr(request.resource.data, 'at', 40)
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['parent', 'child']
          && validCode(request.resource.data.code, familyId, request.resource.data.memberId, request.resource.data.role);
        allow read: if signedIn() && (request.auth.uid == uid || isMember(familyId));
        allow update: if isMember(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
          && request.resource.data.status in ['approved', 'denied'];
        // Yêu cầu đã được Đồng ý là bằng chứng vai trò của máy: máy còn trong gia đình không tự xóa được
        // (để không tự đổi thành "máy của con"). Máy đã rời / bị gỡ thì xóa được để xin vào lại.
        allow delete: if signedIn() && (isOwner(familyId)
          || (request.auth.uid == uid && (resource.data.status != 'approved' || !isMember(familyId))));
      }
      // Gói cước của gia đình. Người trong gia đình đọc / ghi; ngày bắt đầu dùng thử và mã giới thiệu
      // không đổi được; mã giới thiệu đã nhập thì không đổi sang mã khác.
      // Lưu ý: gói đã trả (paidUntil) do máy ghi sau khi Google Play / App Store báo thanh toán xong.
      // Khi bật Cloud Functions (gói Blaze) nên chuyển phần này sang máy chủ kiểm tra hóa đơn.
      match /meta/billing {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && validBilling(request.resource.data)
          && exists(/databases/$(database)/documents/referralCodes/$(request.resource.data.refCode))
          && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.refCode)).data.familyId == familyId;
        allow update: if isMember(familyId) && validBilling(request.resource.data)
          && request.resource.data.trialStart == resource.data.trialStart
          && request.resource.data.refCode == resource.data.refCode
          && (!('referredBy' in resource.data) || request.resource.data.referredBy == resource.data.referredBy);
        allow delete: if isOwner(familyId);
      }
      // sentAlerts: chỉ máy chủ dùng (chống gửi trùng, khi bật Cloud Functions).
    }

    // Mã kết nối 6 số: người trong gia đình tạo. Máy mới đọc được mã (để biết gia đình nào, bố/mẹ nào)
    // khi biết đúng mã và mã còn hạn; không ai liệt kê được danh sách mã.
    // Tạo đè mã đang có bị tính là sửa → bị từ chối, app tự thử mã khác.
    match /pairingCodes/{code} {
      allow create: if code.matches('^[0-9]{6}$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAtMs is int
        && request.resource.data.get('role', 'parent') in ['parent', 'child']
        && isMember(request.resource.data.familyId);
      allow get: if signedIn() && resource.data.expiresAtMs > request.time.toMillis();
      // Liệt kê mã của gia đình mình (để xóa hết khi xóa gia đình).
      allow list: if isMember(resource.data.familyId);
      allow delete: if isMember(resource.data.familyId);
    }

    // Mã giới thiệu: mỗi gia đình một mã. Ai đăng nhập cũng kiểm tra được mã có thật (get), không ai liệt kê được.
    // Tạo đè mã đang có bị tính là sửa → bị từ chối, app tự thử mã khác.
    match /referralCodes/{code} {
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['familyId', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.familyId);
      allow get: if signedIn();
      allow delete: if isMember(resource.data.familyId);
      // Một lượt giới thiệu thành công: gia đình được giới thiệu tự ghi khi trả phí lần đầu (mã của họ làm mã tài liệu).
      // Chỉ ghi được nếu gói của họ thật sự đã nhập mã này. Gia đình đã giới thiệu đọc được để tính phần giảm 5%.
      match /uses/{useCode} {
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['code', 'paidAt'])
          && request.resource.data.code == useCode && str(request.resource.data.paidAt, 40)
          && exists(/databases/$(database)/documents/referralCodes/$(useCode))
          && isMember(get(/databases/$(database)/documents/referralCodes/$(useCode)).data.familyId)
          && get(/databases/$(database)/documents/families/$(get(/databases/$(database)/documents/referralCodes/$(useCode)).data.familyId)/meta/billing).data.referredBy == code;
        allow read: if isMember(get(/databases/$(database)/documents/referralCodes/$(code)).data.familyId);
      }
    }

    // Đăng ký dùng thử từ trang web: ai cũng gửi được (chưa cần đăng nhập), không ai đọc / sửa được từ web.
    // Xem danh sách trong Firebase console. Nên bật App Check cho web khi có nhiều đăng ký rác.
    match /signups/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'role', 'phoneType', 'plan', 'ref', 'at'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.phone, 20) && request.resource.data.phone.size() >= 9
        && optStr(request.resource.data, 'email', 120) && optStr(request.resource.data, 'ref', 20)
        && request.resource.data.role in ['child', 'parent']
        && request.resource.data.phoneType in ['android', 'iphone', 'none', 'unknown']
        && request.resource.data.plan in ['small', 'medium', 'large', 'undecided']
        && str(request.resource.data.at, 40);
      allow read, update, delete: if false;
    }

    // pairingAttempts: chỉ máy chủ dùng (giới hạn số lần nhập mã).
  }
}
