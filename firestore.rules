rules_version = '2';

// Luật bảo mật cho An Tâm (chạy được trên Firebase gói miễn phí Spark, không cần Cloud Functions).
// Chỉ người trong gia đình (uid có trong families/{id}.uids) mới đọc / ghi được dữ liệu gia đình đó.
// Vào gia đình: máy mới nhập mã 6 số → gửi yêu cầu (joinRequests/{uid}) → người trong gia đình bấm
// "Đồng ý" thì mới được thêm uid. Đoán trúng mã cũng không tự vào được.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.uids;
    }

    function addsOneRequester(familyId) {
      let added = request.resource.data.uids.removeAll(resource.data.uids);
      return request.resource.data.uids.hasAll(resource.data.uids)
        && added.size() == 1
        && exists(/databases/$(database)/documents/families/$(familyId)/joinRequests/$(added[0]));
    }
    // Mã kết nối có 2 loại: role 'parent' (máy của bố/mẹ, kèm memberId) và 'child' (máy mới của con, memberId rỗng).
    function validCode(code, familyId, memberId, role) {
      let path = /databases/$(database)/documents/pairingCodes/$(code);
      let c = get(path).data;
      return exists(path)
        && c.familyId == familyId
        && c.memberId == memberId
        && c.get('role', 'parent') == role
        && c.expiresAtMs > request.time.toMillis();
    }

    match /families/{familyId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      // Tạo gia đình mới: chỉ có chính mình trong danh sách.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.uids == [request.auth.uid];
      // Người trong gia đình được: sửa cài đặt; thêm ĐÚNG MỘT máy đã gửi yêu cầu vào gia đình;
      // hoặc bỏ bớt máy (vẫn phải còn ít nhất một người).
      allow update: if isMember(familyId) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids']) && (
          addsOneRequester(familyId)
          || (resource.data.uids.hasAll(request.resource.data.uids) && request.resource.data.uids.size() >= 1)
        ))
      );
      allow delete: if false;

      // Dữ liệu gia đình: người, người nhận cảnh báo, thuốc, lịch khám, sự kiện.
      match /{coll}/{docId} {
        allow read, write: if isMember(familyId)
          && coll in ['members', 'caregivers', 'medications', 'appointments',
                      'doseLogs', 'checkins', 'bpReadings', 'sosEvents'];
      }
      // Nhịp "còn sống" của máy bố mẹ.
      match /heartbeats/{memberId} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId) && request.resource.data.uid == request.auth.uid;
      }
      // Thông tin từng máy (vai trò, mã nhận thông báo): mỗi máy chỉ sửa của chính mình.
      match /devices/{uid} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId) && uid == request.auth.uid
          && (!('role' in request.resource.data) || request.resource.data.role in ['child', 'parent']);
      }
      // Yêu cầu vào gia đình: máy mới tự tạo (phải có mã đúng, còn hạn); người trong gia đình
      // đồng ý / từ chối. Máy mới đọc được yêu cầu của chính mình để biết kết quả.
      match /joinRequests/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['parent', 'child']
          && validCode(request.resource.data.code, familyId, request.resource.data.memberId, request.resource.data.role);
        allow read: if signedIn() && (request.auth.uid == uid || isMember(familyId));
        allow update: if isMember(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
          && request.resource.data.status in ['approved', 'denied'];
        allow delete: if signedIn() && (request.auth.uid == uid || isMember(familyId));
      }
      // sentAlerts: chỉ máy chủ dùng (chống gửi trùng, khi bật Cloud Functions).
    }

    // Mã kết nối 6 số: người trong gia đình tạo. Máy mới đọc được mã (để biết gia đình nào, bố/mẹ nào)
    // khi biết đúng mã và mã còn hạn; không ai liệt kê được danh sách mã.
    // Tạo đè mã đang có bị tính là sửa → bị từ chối, app tự thử mã khác.
    match /pairingCodes/{code} {
      allow create: if code.matches('^[0-9]{6}$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAtMs is int
        && request.resource.data.get('role', 'parent') in ['parent', 'child']
        && isMember(request.resource.data.familyId);
      allow get: if signedIn() && resource.data.expiresAtMs > request.time.toMillis();
      allow delete: if isMember(resource.data.familyId);
    }

    // pairingAttempts: chỉ máy chủ dùng (giới hạn số lần nhập mã).
  }
}
