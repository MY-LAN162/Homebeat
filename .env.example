# Cấu hình Firebase cho app. Chép file này thành .env rồi điền giá trị
# (Firebase console › Project settings › Your apps › Web app › SDK config).
# Để trống thì app chạy như cũ: chỉ lưu trên máy, chưa đồng bộ.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Khu vực Cloud Functions (phải trùng functions/src/index.ts)
EXPO_PUBLIC_FIREBASE_REGION=asia-southeast1
# Chạy thử với Firebase Emulator: điền IP máy tính đang chạy emulator, vd 192.168.1.10
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
# App Check trên web (tùy chọn): site key reCAPTCHA v3
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
# App Check trên bản development build của điện thoại (tùy chọn): mã debug đã thêm trong Firebase console
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Link tải app gửi kèm mã kết nối (link cửa hàng hoặc link file .apk). Trống thì tin nhắn ghi "người gửi sẽ gửi file cài".
EXPO_PUBLIC_DOWNLOAD_URL=
# Link trang web sản phẩm (vd https://an-tam.web.app): tin giới thiệu gửi kèm link ?gt=MÃ
EXPO_PUBLIC_WEB_URL=
